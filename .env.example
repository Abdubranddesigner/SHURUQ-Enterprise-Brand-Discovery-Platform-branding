# ==============================================================================
# SHURUQ ENTERPRISE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# All email transmission takes place strictly on the serverless backend.
# Never expose SMTP credentials with VITE_ prefixes or in client-side code.
# SMTP_PASS requires a Google 16-character App Password (not your Gmail login password).
# See DEPLOYMENT.md for step-by-step instructions.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=shuruqenterprise@gmail.com
SMTP_PASS=your_16_character_google_app_password
EMAIL_TO=shuruqenterprise@gmail.com
